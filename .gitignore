# окружение
.venv/
__pycache__/
*.pyc

# веса моделей (большие, тянутся при первом запуске)
models/
*.pt
*.pth
*.onnx

# результаты прогона
outputs/
outputs_*/
runs/
runs_train/
# datasets/ игнорируется ПОКРОМЕ малых текстовых файлов eval-набора: manifest,
# holdout-список и ручная разметка — носители held-out дисциплины P0
# (docs/EVAL.md); свежий клон без них молча терял бы гейт контаминации и
# 2-4 часа ручной разметки (ревью 2026-07-07). Кадры (frames/) — бинарники,
# остаются вне git: набор воспроизводится scripts/make_eval_set.py.
datasets/*
!datasets/eval_v1/
datasets/eval_v1/*
!datasets/eval_v1/manifest.csv
!datasets/eval_v1/holdout_scenes.txt
!datasets/eval_v1/annotations.json

# исходные фото-семплы (большие бинарники с произвольными именами)
/*.jpg
/*.jpeg
/*.png

# временное
*_brief_tail.txt
.pytest_cache/
_repro_*.py
*.crdownload
outputs_pairs_run.log

# сырые фото выездов (раскладываются в datasets/ скриптом ingest_local_pairs.py)
Проэкт/

# локальные артефакты (конфиг Obsidian-вольта, бинарные отчёты)
.obsidian/
.claude/
*.docx
